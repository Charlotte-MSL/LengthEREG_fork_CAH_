            <criteria p7:any_Attr="Temperature Range" xmlns:p7="https://www.measurement.govt.nz/equipment-register">
              <p7:any_element>19 °C to 21 °C</p7:any_element>
            </criteria>
            <equation>
              <value variables="T">T + (0.0)</value>
              <uncertainty variables="">0.05</uncertainty>
              <unit>°C</unit>
              <ranges>
                <range variable="T">
