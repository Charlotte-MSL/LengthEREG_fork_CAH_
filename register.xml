    <calibrations>
      <measurand quantity="Humidity" calibrationInterval="5">
        <component name="Hygrometer">
          <report>
            <reportNumber>18-12-39</reportNumber>
            <reportIssueDate>2018-12-12</reportIssueDate>
            <measurementStartDate>2018-10-08</measurementStartDate>
            <measurementStopDate>2018-10-08</measurementStopDate>
            <issuingLaboratory>Vaisala Finland</issuingLaboratory>
            <technicalProcedure>Not Stated</technicalProcedure>
            <criteria p7:any_Attr="Humidity Range" xmlns:p7="https://www.measurement.govt.nz/equipment-register">
              <p7:any_element>0 to 95 Hpa</p7:any_element>
            </criteria>
            <equation>
              <value variables="Hc">H -0.2</value>
              <uncertainty variables="">1.0</uncertainty>
              <unit>%rh</unit>
              <ranges>
                <range variable="Hc">
                  <minimum>0</minimum>
                  <maximum>95</maximum>
