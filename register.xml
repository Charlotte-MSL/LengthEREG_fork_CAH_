          <report>
            <reportNumber>18-12-39</reportNumber>
            <reportIssueDate>2018-12-12</reportIssueDate>
            <measurementStartDate>2018-10-08</measurementStartDate>
            <measurementStopDate>2018-10-08</measurementStopDate>
            <issuingLaboratory>Vaisala Finland</issuingLaboratory>
            <technicalProcedure>Not Stated</technicalProcedure>
            <criteria>
              <temperatureRange>19 °C to 21 °C</temperatureRange>
            </criteria>
            <equation>
              <value variables="T">T + (0.0)</value>
              <uncertainty variables="">0.05</uncertainty>
              <unit>°C</unit>
              <ranges>
                <range variable="T">
                  <minimum>19</minimum>
                  <maximum>21</maximum>
